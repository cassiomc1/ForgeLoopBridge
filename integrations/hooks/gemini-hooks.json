{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node integrations/hooks/bridge-hook.mjs --host gemini"
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node integrations/hooks/bridge-hook.mjs --host gemini"
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node integrations/hooks/bridge-hook.mjs --host gemini"
          }
        ]
      }
    ]
  }
}
