# Master-Agent Bridge Environment Configuration

# Server configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Authentication tokens (generate strong 32-byte tokens with: openssl rand -hex 32)
# MASTER_TOKEN is used by the Master (Orchestrator / Architect)
MASTER_TOKEN=replace_with_a_secure_master_token_32chars

# AGENT_TOKEN is used by the Agent (Worker / Executor)
AGENT_TOKEN=replace_with_a_secure_agent_token_32chars

# Database path (optional, defaults to data/bridge.db)
BRIDGE_DB=data/bridge.db

# Rate limiting (optional sliding window)
# RATE_LIMIT_POSTS=60
# RATE_LIMIT_WINDOW=60
