# ForgeLoopBridge Configuration
# Generate strong 32-byte hex tokens with: openssl rand -hex 32

ENGINEER_TOKEN=change_me_to_a_secure_engineer_token
WORKER_TOKEN=change_me_to_a_secure_worker_token

# Server options
HOST=0.0.0.0
PORT=8000
FORGEBRIDGE_DB=data/forgebridge.db
RELOAD=0

# ForgeLoop compatibility is discovered from protocol-info, not package version.
# Bridge remains transport-only: it never stores provider credentials, recalls
# advisory context automatically, or accepts canonical handoffs on message receipt.

# Rate limiting and pagination. Server-generated 429 responses include Retry-After seconds.
# Reverse proxies may apply additional independent limits.
RATE_LIMIT_POSTS=30
RATE_LIMIT_WINDOW=60
SSE_TICKET_RATE_LIMIT=30
SSE_TICKET_RATE_WINDOW=60
DEFAULT_PAGE_SIZE=200
SSE_QUEUE_SIZE=256
SSE_TICKET_TTL=30
MAX_TYPED_ENVELOPE_BYTES=65536
LOG_LEVEL=INFO

# Optional Live Execution Observer (shell.online, read-only, E2EE).
# Disabled by default; opt in explicitly. No secrets here.
# Accepted values: none | shell-online
FORGEBRIDGE_LIVE_OBSERVER=none
FORGEBRIDGE_LIVE_OBSERVER_COMMAND=shell
