# ForgeLoopBridge Configuration
# Generate strong 32-byte hex tokens with: openssl rand -hex 32

ENGINEER_TOKEN=change_me_to_a_secure_engineer_token
WORKER_TOKEN=change_me_to_a_secure_worker_token

# Server options
HOST=0.0.0.0
PORT=8000
FORGEBRIDGE_DB=data/forgebridge.db
RELOAD=0

# Rate limiting and pagination
RATE_LIMIT_POSTS=30
RATE_LIMIT_WINDOW=60
SSE_TICKET_RATE_LIMIT=30
SSE_TICKET_RATE_WINDOW=60
DEFAULT_PAGE_SIZE=200
SSE_QUEUE_SIZE=256
SSE_TICKET_TTL=30
LOG_LEVEL=INFO
