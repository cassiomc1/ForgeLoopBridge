# Master-Agent Bridge Configuration
# Generate strong 32-byte hex tokens with: openssl rand -hex 32

# Master and Agent Authentication
MASTER_TOKEN=change_me_to_a_secure_master_token_32_bytes
AGENT_TOKEN=change_me_to_a_secure_agent_token_32_bytes

# (Optional fallback legacy tokens for backward compatibility)
# ENGINEER_TOKEN=
# WORKER_TOKEN=

# Server options
HOST=0.0.0.0
PORT=8000
BRIDGE_DB=data/bridge.db
RELOAD=0

# Rate limiting and sliding window protection
RATE_LIMIT_POSTS=60
RATE_LIMIT_WINDOW=60
SSE_TICKET_RATE_LIMIT=60
SSE_TICKET_RATE_WINDOW=60
DEFAULT_PAGE_SIZE=200
SSE_QUEUE_SIZE=256
SSE_TICKET_TTL=30
MAX_TYPED_ENVELOPE_BYTES=65536
LOG_LEVEL=INFO
